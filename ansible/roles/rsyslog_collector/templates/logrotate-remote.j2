# {{ ansible_managed }}
# Remote logs are owned by "syslog", so logrotate must switch user.
{{ rsyslog_remote_log_dir }}/*/*.log {
    daily
    maxsize {{ rsyslog_remote_maxsize }}
{% if syslog_archive_enabled | bool %}
    # Local copies are removed by syslog-archive after {{ rsyslog_remote_retention_days }} days once
    # confirmed in Blob Storage. This is only a safety net if uploads keep failing.
    rotate 10000
    maxage {{ (rsyslog_remote_retention_days | int) + (syslog_archive_grace_days | int) }}
{% else %}
    rotate {{ rsyslog_remote_retention_days }}
    maxage {{ rsyslog_remote_retention_days }}
{% endif %}
    missingok
    notifempty
    compress
    delaycompress
    dateext
    dateformat -%Y%m%d-%s
    create 0640 syslog adm
    su syslog adm
    sharedscripts
    postrotate
        /usr/lib/rsyslog/rsyslog-rotate
    endscript
}

/var/log/rsyslog-stats.log {
    weekly
    rotate 4
    missingok
    notifempty
    compress
    su syslog adm
    postrotate
        /usr/lib/rsyslog/rsyslog-rotate
    endscript
}
