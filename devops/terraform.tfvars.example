# Copy to terraform.tfvars (git-ignored).
subscription_id   = "11111111-1111-1111-1111-111111111111"
subscription_name = "sub-shared-services-prd"
location          = "australiaeast"
environment       = "prd"

identity_resource_group_name   = "rg-syslog-devops-prd-aue-001"
create_identity_resource_group = true
tags = { Owner = "platform-team@contoso.com", CostCenter = "IT-1234", ManagedBy = "Terraform" }

# Scopes the pipeline may touch (same resources as ../terraform/terraform.tfvars)
workload_scope_id          = "/subscriptions/11111111-1111-1111-1111-111111111111" # or the existing RG ID
subnet_ids                 = ["/subscriptions/2222.../resourceGroups/rg-connectivity-prd-aue-001/providers/Microsoft.Network/virtualNetworks/vnet-hub-prd-aue-001/subnets/snet-sharedsvc-prd-aue-001"]
private_dns_zone_ids       = ["/subscriptions/2222.../resourceGroups/rg-dns-prd-aue-001/providers/Microsoft.Network/privateDnsZones/internal.contoso.com"]
log_analytics_workspace_id = "/subscriptions/3333.../resourceGroups/rg-management-prd-aue-001/providers/Microsoft.OperationalInsights/workspaces/law-mgmt-prd-aue-001"
key_vault_id               = "/subscriptions/1111.../resourceGroups/rg-sharedsvc-prd-aue-001/providers/Microsoft.KeyVault/vaults/kv-sharedsvc-prd-aue-01"
state_storage_account_id   = "/subscriptions/3333.../resourceGroups/rg-tfstate-prd-aue-001/providers/Microsoft.Storage/storageAccounts/sttfstateprdaue001"

# Azure DevOps
azuredevops_org_url       = "https://dev.azure.com/contoso"
azuredevops_project       = "platform"
approver_group_name       = "Platform Approvers"
allowed_branch            = "refs/heads/main"

# export TF_VAR_admin_ssh_public_key="$(cat ~/.ssh/syslog_admin.pub)"
